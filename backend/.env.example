# ORYN backend configuration. Copy to `.env` and fill in. NEVER commit the real .env file.
# All values here are placeholders.

# --- Application ------------------------------------------------------------------------------
APP_ENV=development                # development | test | production
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=
LOG_LEVEL=INFO

# --- Database (PostgreSQL 14+ required: full-text search + JSONB) -------------------------------
# Render gives a URL starting with postgres:// -- change the scheme to postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://oryn:oryn@localhost:5432/oryn

# --- Sessions / CORS ----------------------------------------------------------------------------
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
# Comma-separated explicit browser origins allowed to call the API (no wildcard, no trailing slash)
FRONTEND_ORIGINS=http://localhost:5173
# Production over HTTPS: COOKIE_SECURE=true. Cross-site frontend/backend domains: COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Optional, e.g. .example.com to share the cookie across subdomains
COOKIE_DOMAIN=

# --- OpenAI ---------------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536          # must equal the Pinecone index dimension
# Leave empty (OPENAI_TEMPERATURE=) for models that reject the temperature parameter
OPENAI_TEMPERATURE=0.1

# --- Pinecone -------------------------------------------------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX_NAME=oryn
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE_PREFIX=ws-      # one namespace per workspace: ws-<workspace_id>
# true: create the serverless index on first use if it does not exist
PINECONE_AUTO_CREATE_INDEX=true

# --- Cohere ---------------------------------------------------------------------------------------
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5

# --- Google OAuth (see docs/GOOGLE_OAUTH_SETUP.md) ----------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" in Google Cloud Console (this is the BACKEND URL)
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_POST_LOGIN_URL=http://localhost:5173/app
FRONTEND_LOGIN_URL=http://localhost:5173/login

# --- Uploads / storage ----------------------------------------------------------------------------
MAX_UPLOAD_BYTES=26214400          # 25 MB per file
MAX_FILES_PER_REQUEST=10
# On Render this MUST be a persistent disk mount path (e.g. /var/data/storage)
STORAGE_DIR=./storage
TEMP_DIR=./tmp

# --- Ingestion / retrieval tuning -------------------------------------------------------------------
CHUNK_SIZE_CHARS=4000              # characters, not tokens (~1000 tokens)
CHUNK_OVERLAP_CHARS=700
# inline: worker thread inside the API process | separate: run `python -m app.workers.ingestion_worker` | off
INGESTION_WORKER_MODE=inline
DENSE_TOP_K=30
LEXICAL_TOP_K=30
RERANK_CANDIDATES=30
CONTEXT_CHUNKS=5
MIN_RERANK_SCORE=0.05

# --- Rate limits (per minute, per process) --------------------------------------------------------
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_CHAT_PER_MINUTE=30

# --- Administrator provisioning -------------------------------------------------------------------
# Optional: the account created via Google sign-in with THIS verified email becomes a global admin.
# Alternatively promote an existing account:  python -m app.cli make-admin --email you@example.com
BOOTSTRAP_ADMIN_EMAIL=
