# Public configuration only. Everything prefixed VITE_ is embedded in the browser bundle,
# so NEVER put secrets here (no API keys, no OAuth client secret).

# Base URL of the ORYN backend, without a trailing slash or /api/v1.
# Local development: leave empty; the Vite dev server proxies /api to http://localhost:8000.
# Production example: https://api.example.com
VITE_API_BASE_URL=

# Local dev only: where the Vite proxy forwards /api (default http://localhost:8000)
# VITE_DEV_PROXY=http://localhost:8000
